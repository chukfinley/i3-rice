#!/bin/bash
# Dynamically assign workspace ranges to connected outputs.
# Moves existing workspaces first, then generates config and reloads
# (only if config actually changed, to avoid unnecessary reload cascades).

CONFIG="$HOME/.config/regolith3/i3/config.d/90_workspace_outputs"

# Get active outputs with eDP-1 (laptop) always first, then others by position
mapfile -t OUTPUTS < <(i3-msg -t get_outputs | jq -r '.[] | select(.active) | "\(.rect.x) \(.rect.y) \(.name)"' | awk '{
    if ($3 ~ /^eDP/) print "0 0 " $3; else print "1 " $1 " " $2 " " $3
}' | sort -n -k1 -k2 -k3 | awk '{print $NF}')

NUM_OUTPUTS=${#OUTPUTS[@]}
LAST_OUTPUT="${OUTPUTS[$((NUM_OUTPUTS - 1))]}"

# Move existing workspaces to their correct outputs BEFORE reload
FOCUSED=$(i3-msg -t get_workspaces | jq -r '.[] | select(.focused) | .name')

declare -A USED  # USED[number]=1 for every workspace number already present

for ws_info in $(i3-msg -t get_workspaces | jq -r '.[] | "\(.name):\(.output)"'); do
    ws="${ws_info%%:*}"
    [[ "$ws" =~ ^[0-9]+$ ]] && USED[$ws]=1
done

for ws_info in $(i3-msg -t get_workspaces | jq -r '.[] | "\(.name):\(.output)"'); do
    ws="${ws_info%%:*}"
    current_output="${ws_info##*:}"

    if [[ "$ws" =~ ^[0-9]+$ ]]; then
        idx=$(( (ws - 1) / 10 ))
        if (( idx >= NUM_OUTPUTS )); then
            # Workspace number belongs to a removed output — reparent to
            # last remaining output AND renumber into that output's range
            # so per-monitor shortcuts (Super+1-9) can reach it.
            target="$LAST_OUTPUT"
            target_idx=$((NUM_OUTPUTS - 1))
        else
            target="${OUTPUTS[$idx]}"
            target_idx=$idx
        fi

        # Renumber if ws falls outside target's [idx*10+1 .. idx*10+9] range
        range_lo=$((target_idx * 10 + 1))
        range_hi=$((target_idx * 10 + 9))
        new_ws="$ws"
        if (( ws < range_lo || ws > range_hi )); then
            for cand in $(seq "$range_lo" "$range_hi"); do
                if [[ -z "${USED[$cand]}" ]]; then
                    new_ws=$cand
                    USED[$cand]=1
                    unset 'USED[$ws]'
                    break
                fi
            done
        fi

        if [[ "$new_ws" != "$ws" ]]; then
            i3-msg "rename workspace \"$ws\" to \"$new_ws\"" >/dev/null
            ws=$new_ws
        fi

        if [[ "$current_output" != "$target" ]]; then
            i3-msg "workspace $ws; move workspace to output $target" >/dev/null
        fi
    fi
done

# Restore focus
i3-msg "workspace $FOCUSED" >/dev/null

# Generate new workspace-to-output config
NEW_CONFIG=$(
    echo "# Auto-generated by i3-assign-workspaces — do not edit"
    for i in "${!OUTPUTS[@]}"; do
        offset=$((i * 10))
        for ws in $(seq 1 9); do
            echo "workspace $((offset + ws)) output ${OUTPUTS[$i]}"
        done
        echo ""
    done
)

# Only reload i3 if the config actually changed (avoids triggering
# another RandR event cascade via the monitor daemon).
OLD_CONFIG=""
[[ -f "$CONFIG" ]] && OLD_CONFIG=$(cat "$CONFIG")

if [[ "$NEW_CONFIG" != "$OLD_CONFIG" ]]; then
    echo "$NEW_CONFIG" > "$CONFIG"
    i3-msg reload
fi
