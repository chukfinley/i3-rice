#!/bin/bash
# Monitor daemon — a TRIGGER, not a layout brain.
#
# Listens for X RandR screen-change events and calls dock-layout.sh, which is
# the single source of truth for layout + workspace assignment. dock-layout.sh
# is idempotent, so firing on every event is harmless (no-op when the layout is
# already correct). The hardware-level trigger lives in udev; this daemon only
# covers X-side changes (e.g. `regolith-look refresh`) and acts as a backup.
#
# Self-healing: if xev dies (X restart, broken pipe during MST enumeration) the
# outer loop restarts it instead of letting the daemon die silently.
#
# Single instance enforced via pidfile.

PIDFILE="/tmp/i3-monitor-daemon.pid"
DEBOUNCE_SECS=2

if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
    exit 0  # already running
fi
echo $$ > "$PIDFILE"
trap 'rm -f "$PIDFILE"' EXIT

while true; do
    xev -root -event randr 2>/dev/null | while read -r line; do
        if [[ "$line" == *RRScreenChangeNotify* ]]; then
            # Debounce: drain events until the bus is quiet for DEBOUNCE_SECS,
            # then act once on the settled state.
            while read -t "$DEBOUNCE_SECS" -r _; do :; done
            ~/.local/bin/dock-layout.sh
        fi
    done
    # xev exited — X gone or pipe broke. Wait, then respawn so we self-heal.
    sleep 2
done
