#!/bin/bash
# Monitor daemon that detects display changes and reassigns workspaces
# Uses xev to listen for RandR events with proper debouncing.
#
# Only one instance should run at a time (enforced by pidfile).

PIDFILE="/tmp/i3-monitor-daemon.pid"
DEBOUNCE_SECS=3

# --- Single-instance guard ---
if [[ -f "$PIDFILE" ]]; then
    OLD_PID=$(cat "$PIDFILE")
    if kill -0 "$OLD_PID" 2>/dev/null; then
        # Another instance is already running — exit silently
        exit 0
    fi
fi
echo $$ > "$PIDFILE"
trap 'rm -f "$PIDFILE"' EXIT

# Track current output state
get_state() {
    xrandr --query | grep ' connected' | sort
}

LAST_STATE=$(get_state)

# Listen for RandR screen change events.
# We debounce by draining all events that arrive within DEBOUNCE_SECS of
# the first one, then acting once on the final stable state.
xev -root -event randr 2>/dev/null | while read -r line; do
    if echo "$line" | grep -q "RRScreenChangeNotify"; then
        # An event arrived. Wait for the dust to settle: keep resetting a
        # timer as long as new events keep arriving within the window.
        while read -t "$DEBOUNCE_SECS" -r next_line; do
            # drain — just keep waiting until no event for DEBOUNCE_SECS
            :
        done

        NEW_STATE=$(get_state)
        if [[ "$NEW_STATE" != "$LAST_STATE" ]]; then
            LAST_STATE="$NEW_STATE"
            ~/.local/bin/i3-assign-workspaces
        fi
    fi
done
