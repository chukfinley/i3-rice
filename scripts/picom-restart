#!/bin/bash
# Restart picom cleanly. Called by exec_always so it runs on every i3 restart.
# Picom breaks (keeps running but stops compositing) after regolith-look refresh
# or i3 restart, so we must kill and relaunch it.

pkill -9 picom 2>/dev/null
sleep 0.5
picom -b --config ~/.config/dwm/picom.conf

# Set wallpaper (feh gets reset on i3 restart)
feh --bg-fill /home/user/pic/wal/wallhaven-8gkeej.jpg
