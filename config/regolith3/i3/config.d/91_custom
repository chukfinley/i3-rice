# Focus follows mouse
focus_follows_mouse yes

# Move/resize windows with Super + mouse
# Left mouse = move, Right mouse = resize
floating_modifier $mod
tiling_drag modifier

# Set monitor geometry + assign workspaces on every i3 start/reload.
# dock-layout.sh is idempotent and calls i3-assign-workspaces itself at the end,
# so geometry is fixed BEFORE workspaces are assigned (otherwise assignment runs
# against X's default layout and strands workspaces on the wrong outputs at boot).
# The daemon watches for later runtime monitor changes (pidfile-guarded).
exec_always --no-startup-id ~/.local/bin/dock-layout.sh --force
exec_always --no-startup-id ~/.local/bin/i3-monitor-daemon

# Picom: kill and restart on every i3 restart (picom breaks but stays alive)
exec_always --no-startup-id ~/.local/bin/picom-restart

# Reiche die volle Session-Env an D-Bus + systemd-user weiter, damit
# D-Bus-aktivierte Apps (Caja via org.freedesktop.FileManager1, gvfs/Papierkorb)
# von Flatpaks (Zen, JDownloader) korrektes Theme + funktionierende Umgebung kriegen.
exec_always --no-startup-id dbus-update-activation-environment --systemd --all

# Autostart
exec --no-startup-id /usr/bin/dunst
exec --no-startup-id /usr/bin/signal-desktop --start-in-tray
exec --no-startup-id redshift
# greenclip disabled — 557MB RAM leak (unused, vicinae clipboard used instead)
# exec --no-startup-id greenclip daemon
exec --no-startup-id vicinae server

# skippy-xd: Exposé/Preview-Daemon (Mission-Control-Style Fenster-Übersicht)
exec --no-startup-id skippy-xd --start-daemon

# Custom Keybindings

# Super+B to toggle bar visibility
bindsym $mod+b bar mode toggle

# Super+W to lock screen (sleep lets i3 release the key grab before slock grabs)
bindsym --release $mod+w exec slock

# Super+Shift+Space to toggle floating mode
bindsym $mod+Shift+space floating toggle

# --- Fenster-Übersicht (skippy-xd, gepatcht mit Tipp-Filter) ---
# Super+E: Preview-Raster aller Fenster über alle Workspaces.
# Einfach lostippen filtert nach Titel (Highlight springt auf Treffer), Enter wählt.
bindsym $mod+e exec --no-startup-id skippy-xd --expose --desktop -1 --toggle

# Super+Shift+V for Tailscale/VPN menu
bindsym $mod+Shift+v exec --no-startup-id ~/.local/bin/tailscale-menu

# Super+R for Plauder (Voice Input)
bindsym $mod+r exec --no-startup-id /home/user/.local/bin/plauder

# Super+Shift+D for Vicinae
bindsym $mod+Shift+d exec --no-startup-id /home/user/.local/bin/vicinae open

# Vicinae: no border
for_window [class="vicinae"] border none

# --- Wispr Flow (Electron Voice-Dictation, Linux-Port) ---
# Seit dem linux-hub-focusable-Patch ist das Hub-Fenster WM-managed und kachelt
# normal — daher KEIN Catch-all-Float mehr. Nur die Overlays (Status-Pill,
# Scratchpad, Context Menu) floaten: sticky (folgen über Workspaces) + no_focus,
# damit die Pill beim Diktieren nicht den Tastatur-Fokus aus dem Editor klaut.
for_window [class="wispr-flow" title="Status"] floating enable, sticky enable, border none
for_window [class="wispr-flow" title="Scratchpad"] floating enable, sticky enable, border none
for_window [class="wispr-flow" title="Context Menu"] floating enable, border none
no_focus [class="wispr-flow" title="Status"]
no_focus [class="wispr-flow" title="Scratchpad"]
no_focus [class="wispr-flow" title="Context Menu"]

# Super+O for screen region OCR (PaddleOCR → clipboard)
# --release so the modifier is released before scrot tries to grab pointer
bindsym --release $mod+o exec --no-startup-id /home/user/git/linux-ocr/capture.sh

# Workspace-Switching per Monitor (Super+1-9)
bindsym $mod+1 exec --no-startup-id /home/user/.local/bin/i3-workspace-per-monitor switch 1
bindsym $mod+2 exec --no-startup-id /home/user/.local/bin/i3-workspace-per-monitor switch 2
bindsym $mod+3 exec --no-startup-id /home/user/.local/bin/i3-workspace-per-monitor switch 3
bindsym $mod+4 exec --no-startup-id /home/user/.local/bin/i3-workspace-per-monitor switch 4
bindsym $mod+5 exec --no-startup-id /home/user/.local/bin/i3-workspace-per-monitor switch 5
bindsym $mod+6 exec --no-startup-id /home/user/.local/bin/i3-workspace-per-monitor switch 6
bindsym $mod+7 exec --no-startup-id /home/user/.local/bin/i3-workspace-per-monitor switch 7
bindsym $mod+8 exec --no-startup-id /home/user/.local/bin/i3-workspace-per-monitor switch 8
bindsym $mod+9 exec --no-startup-id /home/user/.local/bin/i3-workspace-per-monitor switch 9

# Move Window to Workspace per Monitor (Super+Shift+1-9)
bindsym $mod+Shift+1 exec --no-startup-id /home/user/.local/bin/i3-workspace-per-monitor move 1
bindsym $mod+Shift+2 exec --no-startup-id /home/user/.local/bin/i3-workspace-per-monitor move 2
bindsym $mod+Shift+3 exec --no-startup-id /home/user/.local/bin/i3-workspace-per-monitor move 3
bindsym $mod+Shift+4 exec --no-startup-id /home/user/.local/bin/i3-workspace-per-monitor move 4
bindsym $mod+Shift+5 exec --no-startup-id /home/user/.local/bin/i3-workspace-per-monitor move 5
bindsym $mod+Shift+6 exec --no-startup-id /home/user/.local/bin/i3-workspace-per-monitor move 6
bindsym $mod+Shift+7 exec --no-startup-id /home/user/.local/bin/i3-workspace-per-monitor move 7
bindsym $mod+Shift+8 exec --no-startup-id /home/user/.local/bin/i3-workspace-per-monitor move 8
bindsym $mod+Shift+9 exec --no-startup-id /home/user/.local/bin/i3-workspace-per-monitor move 9
